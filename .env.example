# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Personal keys from https://developer.riotgames.com expire every 24 hours.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platform routing value — used by LEAGUE-V4 and other per-server endpoints.
# e.g. na1, euw1, eun1, kr, br1, jp1, la1, la2, oc1, tr1, ru
RIOT_PLATFORM=na1

# Queue to collect. 420 = ranked solo/duo. Do not mix in flex or normals.
RIOT_QUEUE=420

# Optional: pin collection to specific patches, comma separated (e.g. 15.17,15.18).
# Leave blank to accept whatever comes back and filter later.
TARGET_PATCHES=
